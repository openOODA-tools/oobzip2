// # BWT Integrity Checksum Engine
//
// Logline: Bitwise CRC32 implementation for bzip2 block and stream integrity verification.
//
// Setup: Pure arithmetic implementation with 32-bit word constraints.
//
// Beats:
//   1. Update CRC32 accumulator across individual bytes.
//   2. Calculate full checksum for byte buffer or string.
//   3. Format 32-bit CRC into hexadecimal string.

pub fn crc32_byte(crc: Int, b: Int) -> Int {
    let mut c: Int = (crc ^ (b & 255)) & 4294967295;
    let mut i: Int = 0;
    while i < 8 {
        let bit: Int = c & 1;
        c = (c >> 1) & 2147483647;
        if bit != 0 {
            c = (c ^ 3988292384) & 4294967295;
        }
        i = i + 1;
    }
    return c;
}

pub fn calc_crc32(s: String) -> Int {
    let mut crc: Int = 4294967295;
    let len: Int = chars_len(s);
    let mut i: Int = 0;
    while i < len {
        let b: Int = byte_at(s, i);
        crc = crc32_byte(crc, b);
        i = i + 1;
    }
    return (crc ^ 4294967295) & 4294967295;
}

pub fn hex_digit(nibble: Int) -> String {
    let n: Int = nibble & 15;
    if n == 0 { return "0"; }
    if n == 1 { return "1"; }
    if n == 2 { return "2"; }
    if n == 3 { return "3"; }
    if n == 4 { return "4"; }
    if n == 5 { return "5"; }
    if n == 6 { return "6"; }
    if n == 7 { return "7"; }
    if n == 8 { return "8"; }
    if n == 9 { return "9"; }
    if n == 10 { return "a"; }
    if n == 11 { return "b"; }
    if n == 12 { return "c"; }
    if n == 13 { return "d"; }
    if n == 14 { return "e"; }
    return "f";
}

pub fn crc_to_hex(crc: Int) -> String {
    let mut res: String = "";
    let mut shift: Int = 28;
    while shift >= 0 {
        let nibble: Int = (crc >> shift) & 15;
        res = res + hex_digit(nibble);
        shift = shift - 4;
    }
    return res;
}
