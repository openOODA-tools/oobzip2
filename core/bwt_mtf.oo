// # Move-To-Front (MTF) Transform
//
// Logline: Alphabet symbol dynamic ranking transform producing zero-skewed frequency distributions.
//
// Setup: Initializes standard 256-symbol permutation table for fast index lookup.
//
// Beats:
//   1. Initialize 0..255 byte alphabet array.
//   2. Encode byte sequence by symbol rank and move matched symbol to rank 0.
//   3. Decode rank indices back into original byte sequence.

pub fn init_mtf_alphabet() -> List[Int] {
    let mut table: List[Int] = list_new();
    let mut i: Int = 0;
    while i < 256 {
        table = list_push(table, i);
        i = i + 1;
    }
    return table;
}

pub fn mtf_encode(data: String) -> List[Int] {
    let mut table: List[Int] = init_mtf_alphabet();
    let mut out: List[Int] = list_new();
    let len: Int = chars_len(data);
    let mut i: Int = 0;

    while i < len {
        let b: Int = byte_at(data, i);
        let mut idx: Int = 0;
        while idx < 256 {
            if list_get(table, idx) == b {
                out = list_push(out, idx);
                let mut k: Int = idx;
                while k > 0 {
                    table = list_set(table, k, list_get(table, k - 1));
                    k = k - 1;
                }
                table = list_set(table, 0, b);
                idx = 256;
            } else {
                idx = idx + 1;
            }
        }
        i = i + 1;
    }
    return out;
}

pub fn mtf_decode(ranks: List[Int]) -> String {
    let mut table: List[Int] = init_mtf_alphabet();
    let mut out_buf: List[Int] = bytes_new();
    let len: Int = list_len(ranks);
    let mut i: Int = 0;

    while i < len {
        let idx: Int = list_get(ranks, i);
        if idx >= 0 && idx < 256 {
            let b: Int = list_get(table, idx);
            out_buf = bytes_push(out_buf, b);
            let mut k: Int = idx;
            while k > 0 {
                table = list_set(table, k, list_get(table, k - 1));
                k = k - 1;
            }
            table = list_set(table, 0, b);
        }
        i = i + 1;
    }
    return bytes_to_str(out_buf);
}
