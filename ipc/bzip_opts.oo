// # oobzip2 Command-Line Options Parser
//
// Logline: Command-line flag tokenizer and configuration builder for bzip2 actions.
//
// Setup: Parses arguments vector into structured execution parameters.
//
// Beats:
//   1. Declare BzipOpts structure with action and format flags.
//   2. Iterate command arguments and assign operation modes.
//   3. Provide defaults for compression level, action, and JSON flags.

pub type BzipOpts = struct {
    action: String,
    input_text: String,
    level: Int,
    json_mode: Bool,
    mcp_mode: Bool,
    help_mode: Bool,
    version_mode: Bool
};

pub fn default_opts() -> BzipOpts {
    return BzipOpts {
        action: "compress",
        input_text: "",
        level: 9,
        json_mode: false,
        mcp_mode: false,
        help_mode: false,
        version_mode: false
    };
}

pub fn parse_opts(args: List[String]) -> BzipOpts {
    let mut opts: BzipOpts = default_opts();
    let num_args: Int = list_len(args);
    let mut i: Int = 0;

    while i < num_args {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" {
            opts.help_mode = true;
        } else if arg == "-v" || arg == "--version" {
            opts.version_mode = true;
        } else if arg == "--mcp" {
            opts.mcp_mode = true;
        } else if arg == "--json" {
            opts.json_mode = true;
        } else if arg == "-c" || arg == "--compress" {
            opts.action = "compress";
        } else if arg == "-d" || arg == "--decompress" {
            opts.action = "decompress";
        } else if arg == "-t" || arg == "--test" {
            opts.action = "test";
        } else if arg == "-i" || arg == "--inspect" {
            opts.action = "inspect";
        } else if arg == "--bwt" {
            opts.action = "bwt";
        } else if arg == "-1" { opts.level = 1;
        } else if arg == "-2" { opts.level = 2;
        } else if arg == "-3" { opts.level = 3;
        } else if arg == "-4" { opts.level = 4;
        } else if arg == "-5" { opts.level = 5;
        } else if arg == "-6" { opts.level = 6;
        } else if arg == "-7" { opts.level = 7;
        } else if arg == "-8" { opts.level = 8;
        } else if arg == "-9" { opts.level = 9;
        } else if (arg == "-s" || arg == "--string") && (i + 1 < num_args) {
            i = i + 1;
            opts.input_text = list_get(args, i);
        } else if !str_starts_with(arg, "-") && chars_len(opts.input_text) == 0 {
            opts.input_text = arg;
        }
        i = i + 1;
    }

    if chars_len(opts.input_text) > 0 && str_starts_with(opts.input_text, "BZh") && opts.action == "compress" {
        opts.action = "decompress";
    }

    return opts;
}
